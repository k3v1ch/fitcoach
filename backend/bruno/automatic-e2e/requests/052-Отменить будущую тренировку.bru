meta {
  name: Отменить будущую тренировку
  type: http
  seq: 52
}

patch {
  url: {{baseUrl}}/api/v1/organizations/{{organizationId}}/trainings/{{futureTrainingId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-TOKEN: {{csrfToken}}
}

script:pre-request {
  if (!bru.getVar('csrfToken')) throw new Error('Сначала выполните GET auth/csrf в этой коллекции.');
  
}

body:json {
  {
    "status": "CANCELLED",
    "cancelReason": "Bruno cleanup"
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Поле status", function () {
    expect(res.getBody().status).to.equal('CANCELLED');
  });
}

docs {
  Ожидаемый результат проверяется во вкладке Tests. Для изменения данных нужна сессия и актуальный CSRF.
}

