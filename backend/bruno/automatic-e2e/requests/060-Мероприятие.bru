meta {
  name: Мероприятие
  type: http
  seq: 60
}

get {
  url: {{baseUrl}}/api/v1/organizations/{{organizationId}}/events/{{eventId}}
  body: none
  auth: none
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Поле id", function () {
    expect(res.getBody().id).to.equal(bru.getVar('eventId'));
  });
}

docs {
  Ожидаемый результат проверяется во вкладке Tests. Для изменения данных нужна сессия и актуальный CSRF.
}

