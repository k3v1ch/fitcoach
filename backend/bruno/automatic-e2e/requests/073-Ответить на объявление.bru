meta {
  name: Ответить на объявление
  type: http
  seq: 73
}

post {
  url: {{baseUrl}}/api/v1/organizations/{{organizationId}}/announcements/{{announcementId}}/responses
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-TOKEN: {{csrfToken}}
}

script:pre-request {
  if (!bru.getVar('csrfToken')) throw new Error('Сначала выполните GET auth/csrf в этой коллекции.');
  
}

body:json {
  {
    "response": "ACCEPTED",
    "comment": "Bruno"
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Ожидаемый результат проверяется во вкладке Tests. Для изменения данных нужна сессия и актуальный CSRF.
}

