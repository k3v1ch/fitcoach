meta {
  name: Удалить свободное вложение
  type: http
  seq: 81
}

delete {
  url: {{baseUrl}}/api/v1/organizations/{{organizationId}}/files/{{fileId}}
  body: none
  auth: none
}

headers {
  X-CSRF-TOKEN: {{csrfToken}}
}

script:pre-request {
  if (!bru.getVar('csrfToken')) throw new Error('Сначала выполните GET auth/csrf в этой коллекции.');
  
}

tests {
  test("HTTP 204", function () {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  Ожидаемый результат проверяется во вкладке Tests. Для изменения данных нужна сессия и актуальный CSRF.
}

