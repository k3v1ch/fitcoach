meta {
  name: Создать начисление
  type: http
  seq: 83
}

post {
  url: {{baseUrl}}/api/v1/organizations/{{organizationId}}/charges
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-TOKEN: {{csrfToken}}
}

script:pre-request {
  if (!bru.getVar('csrfToken')) throw new Error('Сначала выполните GET auth/csrf в этой коллекции.');
  
}

body:json {
  {
    "athleteId": "{{athleteId}}",
    "sectionId": "{{sectionId}}",
    "type": "SUBSCRIPTION",
    "title": "Charge {{runId}}",
    "amount": 1000,
    "dueOn": "{{dueOn}}",
    "periodFrom": "{{fromDate}}",
    "periodTo": "{{toDate}}"
  }
}

script:post-response {
  if (res.getStatus() >= 200 && res.getStatus() < 300) {
    bru.setVar('chargeId', res.getBody().id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Поле remainingAmount", function () {
    expect(res.getBody().remainingAmount).to.equal(1000);
  });
}

docs {
  Ожидаемый результат проверяется во вкладке Tests. Для изменения данных нужна сессия и актуальный CSRF.
}

