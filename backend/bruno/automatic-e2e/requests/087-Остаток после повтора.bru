meta {
  name: Остаток после повтора
  type: http
  seq: 87
}

get {
  url: {{baseUrl}}/api/v1/organizations/{{organizationId}}/charges/{{chargeId}}
  body: none
  auth: none
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Поле paidAmount", function () {
    expect(res.getBody().paidAmount).to.equal(400);
  });
  test("Поле remainingAmount", function () {
    expect(res.getBody().remainingAmount).to.equal(600);
  });
  test("Поле paymentStatus", function () {
    expect(res.getBody().paymentStatus).to.equal('PARTIALLY_PAID');
  });
}

docs {
  Ожидаемый результат проверяется во вкладке Tests. Для изменения данных нужна сессия и актуальный CSRF.
}

