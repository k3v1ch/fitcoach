meta {
  name: Создать вторую организацию
  type: http
  seq: 104
}

post {
  url: {{baseUrl}}/api/v1/organizations
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-TOKEN: {{csrfToken}}
}

script:pre-request {
  if (!bru.getVar('csrfToken')) throw new Error('Сначала выполните GET auth/csrf в этой коллекции.');
  
}

body:json {
  {
    "name": "Bruno other {{runId}}",
    "timezone": "Asia/Vladivostok"
  }
}

script:post-response {
  if (res.getStatus() >= 200 && res.getStatus() < 300) {
    bru.setVar('otherOrganizationId', res.getBody().id);
  }
}

tests {
  test("HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  Ожидаемый результат проверяется во вкладке Tests. Для изменения данных нужна сессия и актуальный CSRF.
}

