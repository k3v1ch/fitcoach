meta {
  name: Экспорт XLSX по ТЗ
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/organizations/{{organizationId}}/reports/CHARGES/export?format=XLSX&from={{fromDate}}&to={{toDate}}
  body: none
  auth: none
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Заголовок формата", function () {
    expect(res.getHeader('content-type')).to.include('application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
  });
}

docs {
  По ТЗ доступен этот формат; текущая реализация поддерживает только CSV.
}

