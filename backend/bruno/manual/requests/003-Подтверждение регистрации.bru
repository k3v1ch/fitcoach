meta {
  name: Подтверждение регистрации
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/register/confirm
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-TOKEN: {{csrfToken}}
}

script:pre-request {
  if (!bru.getVar('csrfToken')) throw new Error('Сначала выполните GET auth/csrf в этой коллекции.');
  
}

body:json {
  {
    "token": "{{registrationToken}}",
    "fullName": "Bruno Trainer",
    "password": "{{password}}",
    "accountType": "TRAINER"
  }
}

tests {
  test("HTTP 204", function () {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  Укажите действующий токен из письма и пароль 15–128 символов. Текущий DTO не принимает phone.
}

