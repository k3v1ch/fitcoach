meta {
  name: Создать результат
  type: http
  seq: 40
}

post {
  url: {{baseUrl}}/api/v1/organizations/{{organizationId}}/athletes/{{athleteId}}/results
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-TOKEN: {{csrfToken}}
}

script:pre-request {
  if (!bru.getVar('csrfToken')) throw new Error('Сначала выполните GET auth/csrf в этой коллекции.');
  
}

body:json {
  {
    "metricName": "Бег 100м",
    "value": 12.34,
    "unit": "s",
    "measuredOn": "{{today}}",
    "isPersonalBest": true
  }
}

script:post-response {
  if (res.getStatus() >= 200 && res.getStatus() < 300) {
    bru.setVar('resultId', res.getBody().id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Ожидаемый результат проверяется во вкладке Tests. Для изменения данных нужна сессия и актуальный CSRF.
}

