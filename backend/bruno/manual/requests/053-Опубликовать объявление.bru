meta {
  name: Опубликовать объявление
  type: http
  seq: 53
}

patch {
  url: {{baseUrl}}/api/v1/organizations/{{organizationId}}/announcements/{{announcementId}}?status=PUBLISHED
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-TOKEN: {{csrfToken}}
}

script:pre-request {
  if (!bru.getVar('csrfToken')) throw new Error('Сначала выполните GET auth/csrf в этой коллекции.');
  
}

body:json {
  {
    "title": "Announcement {{runId}}",
    "text": "Bruno regression",
    "category": "GENERAL",
    "recipientUserIds": [
      "{{userId}}"
    ],
    "requiresResponse": true,
    "responseDeadline": "{{futureDeadline}}",
    "attachmentFileIds": []
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Ожидаемый результат проверяется во вкладке Tests. Для изменения данных нужна сессия и актуальный CSRF.
}

