meta {
  name: Связать родителя и спортсмена
  type: http
  seq: 83
}

patch {
  url: {{baseUrl}}/api/v1/organizations/{{organizationId}}/athletes/{{athleteId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-TOKEN: {{csrfToken}}
}

script:pre-request {
  if (!bru.getVar('csrfToken')) throw new Error('Сначала выполните GET auth/csrf в этой коллекции.');
  
}

body:json {
  {
    "parentLinks": [
      {
        "parentUserId": "{{parentUserId}}",
        "relationship": "Мать"
      }
    ]
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Тренеру нужны athletes.write и members.write. Родителю нужно ACTIVE PARENT-членство. PATCH заменяет список связей.
}

