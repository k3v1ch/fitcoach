meta {
  name: Ответ участника мероприятия
  type: http
  seq: 84
}

patch {
  url: {{baseUrl}}/api/v1/organizations/{{organizationId}}/events/{{eventId}}/participants/{{athleteId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-TOKEN: {{csrfToken}}
}

script:pre-request {
  if (!bru.getVar('csrfToken')) throw new Error('Сначала выполните GET auth/csrf в этой коллекции.');
  
}

body:json {
  {
    "response": "ACCEPTED",
    "comment": "Приду"
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Войдите как родитель связанного спортсмена или как его ATHLETE. Сначала получите новый CSRF. Мероприятие опубликовано, участник добавлен, срок ответа не прошёл.
}

