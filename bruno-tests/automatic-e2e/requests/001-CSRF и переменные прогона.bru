meta {
  name: CSRF и переменные прогона
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/auth/csrf
  body: none
  auth: none
}

script:pre-request {
  bru.setVar('runId', String(Date.now()) + '-' + Math.random().toString(16).slice(2,10));
  const now = Date.now();
  const day = n => new Date(now + n*86400000).toISOString().slice(0,10);
  bru.setVar('today', day(-1));
  bru.setVar('joinedOn', day(-30));
  bru.setVar('dueOn', day(7));
  bru.setVar('fromDate', day(-60));
  bru.setVar('toDate', day(60));
  bru.setVar('fromInstant', new Date(now-60*86400000).toISOString());
  bru.setVar('toInstant', new Date(now+60*86400000).toISOString());
  bru.setVar('pastStart', new Date(now-2*86400000).toISOString());
  bru.setVar('pastEnd', new Date(now-2*86400000+3600000).toISOString());
  bru.setVar('futureStart', new Date(now+7*86400000).toISOString());
  bru.setVar('futureEnd', new Date(now+7*86400000+3600000).toISOString());
  bru.setVar('futureDeadline', new Date(now+6*86400000).toISOString());
  bru.setVar('paymentKey', 'bruno-' + bru.getVar('runId'));
}

script:post-response {
  if (res.getStatus() >= 200 && res.getStatus() < 300) {
    bru.setVar('csrfToken', res.getBody().token);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("CSRF token", function () {
    expect(res.getBody().token).to.be.a('string').and.not.empty;
    expect(res.getBody().headerName).to.equal('X-CSRF-TOKEN');
  });
}

docs {
  Ожидаемый результат проверяется во вкладке Tests. Для изменения данных нужна сессия и актуальный CSRF.
}

