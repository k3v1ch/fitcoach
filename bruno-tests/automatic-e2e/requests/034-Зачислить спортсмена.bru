meta {
  name: Зачислить спортсмена
  type: http
  seq: 34
}

post {
  url: {{baseUrl}}/api/v1/organizations/{{organizationId}}/groups/{{groupId}}/athletes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-TOKEN: {{csrfToken}}
}

script:pre-request {
  if (!bru.getVar('csrfToken')) throw new Error('Сначала выполните GET auth/csrf в этой коллекции.');
  
}

body:json {
  {
    "athleteId": "{{athleteId}}",
    "joinedOn": "{{joinedOn}}"
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Поле athleteId", function () {
    expect(res.getBody().athleteId).to.equal(bru.getVar('athleteId'));
  });
}

docs {
  Ожидаемый результат проверяется во вкладке Tests. Для изменения данных нужна сессия и актуальный CSRF.
}

