meta {
  name: Черновик отчёта
  type: http
  seq: 42
}

put {
  url: {{baseUrl}}/api/v1/organizations/{{organizationId}}/trainings/{{trainingId}}/report
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-TOKEN: {{csrfToken}}
}

script:pre-request {
  if (!bru.getVar('csrfToken')) throw new Error('Сначала выполните GET auth/csrf в этой коллекции.');
  
}

body:json {
  {
    "topic": "Bruno",
    "actualContent": "Тренировка проведена",
    "status": "DRAFT"
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Поле status", function () {
    expect(res.getBody().status).to.equal('DRAFT');
  });
}

docs {
  Ожидаемый результат проверяется во вкладке Tests. Для изменения данных нужна сессия и актуальный CSRF.
}

