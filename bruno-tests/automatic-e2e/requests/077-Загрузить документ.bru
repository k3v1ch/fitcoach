meta {
  name: Загрузить документ
  type: http
  seq: 77
}

post {
  url: {{baseUrl}}/api/v1/organizations/{{organizationId}}/documents
  body: multipart-form
  auth: none
}

headers {
  X-CSRF-TOKEN: {{csrfToken}}
}

script:pre-request {
  if (!bru.getVar('csrfToken')) throw new Error('Сначала выполните GET auth/csrf в этой коллекции.');
  
}

body:multipart-form {
  file: @file(fixtures/sample.png)
  title: Bruno document
  type: OTHER
  athleteId: {{athleteId}}
  issuedOn: {{today}}
}

script:post-response {
  if (res.getStatus() >= 200 && res.getStatus() < 300) {
    bru.setVar('documentId', res.getBody().id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Поле type", function () {
    expect(res.getBody().type).to.equal('OTHER');
  });
}

docs {
  Ожидаемый результат проверяется во вкладке Tests. Для изменения данных нужна сессия и актуальный CSRF.
}

