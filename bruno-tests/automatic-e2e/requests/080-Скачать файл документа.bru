meta {
  name: Скачать файл документа
  type: http
  seq: 80
}

get {
  url: {{baseUrl}}/api/v1/organizations/{{organizationId}}/files/{{documentFileId}}/content
  body: none
  auth: none
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Заголовки скачивания", function () {
    expect(res.getHeader('content-disposition')).to.include('attachment');
    expect(res.getHeader('content-type')).to.include('application/octet-stream');
  });
}

docs {
  Ожидаемый результат проверяется во вкладке Tests. Для изменения данных нужна сессия и актуальный CSRF.
}

