meta {
  name: Отчёт ATTENDANCE
  type: http
  seq: 94
}

get {
  url: {{baseUrl}}/api/v1/organizations/{{organizationId}}/reports/ATTENDANCE?from={{fromDate}}&to={{toDate}}&page=0&size=20
  body: none
  auth: none
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Таблица отчёта", function () {
    const b=res.getBody();
    expect(b.type).to.equal('ATTENDANCE');
    expect(b.rows).to.be.an('array');
    expect(b.columns).to.be.an('array');
    expect(b.totalElements).to.be.at.least(b.rows.length);
  });
}

docs {
  Ожидаемый результат проверяется во вкладке Tests. Для изменения данных нужна сессия и актуальный CSRF.
}

