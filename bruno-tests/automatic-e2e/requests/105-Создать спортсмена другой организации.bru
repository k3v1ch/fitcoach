meta {
  name: Создать спортсмена другой организации
  type: http
  seq: 105
}

post {
  url: {{baseUrl}}/api/v1/organizations/{{otherOrganizationId}}/athletes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-TOKEN: {{csrfToken}}
}

script:pre-request {
  if (!bru.getVar('csrfToken')) throw new Error('Сначала выполните GET auth/csrf в этой коллекции.');
  
}

body:json {
  {
    "firstName": "Bruno",
    "lastName": "{{runId}}",
    "birthDate": "2010-01-01",
    "status": "ACTIVE",
    "enrolledOn": "{{joinedOn}}",
    "note": "API regression"
  }
}

script:post-response {
  if (res.getStatus() >= 200 && res.getStatus() < 300) {
    bru.setVar('foreignAthleteId', res.getBody().id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Ожидаемый результат проверяется во вкладке Tests. Для изменения данных нужна сессия и актуальный CSRF.
}

