meta {
  name: Результат удалён
  type: http
  seq: 113
}

get {
  url: {{baseUrl}}/api/v1/organizations/{{organizationId}}/athletes/{{athleteId}}/results?page=0&size=20
  body: none
  auth: none
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Пагинация и состав страницы", function () {
    const b = res.getBody();
    expect(b.items).to.be.an('array');
    expect(b.page).to.equal(0);
    expect(b.size).to.equal(20);
    expect(b.items.length).to.be.at.most(20);
    expect(b.totalElements).to.be.a('number').and.at.least(b.items.length);
    expect(b.totalPages).to.equal(Math.ceil(b.totalElements / b.size));
  });
  test("Удалённая запись отсутствует", function () {
    expect(res.getBody().items.map(x=>x.id)).not.to.include(bru.getVar('resultId'));
  });
}

docs {
  Ожидаемый результат проверяется во вкладке Tests. Для изменения данных нужна сессия и актуальный CSRF.
}

