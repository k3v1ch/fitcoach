meta {
  name: Запрос регистрации
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-TOKEN: {{csrfToken}}
}

script:pre-request {
  if (!bru.getVar('csrfToken')) throw new Error('Сначала выполните GET auth/csrf в этой коллекции.');
  
}

body:json {
  {
    "email": "{{registrationEmail}}",
    "accountType": "TRAINER"
  }
}

tests {
  test("HTTP 202", function () {
    expect(res.getStatus()).to.equal(202);
  });
}

docs {
  Текущая реализация принимает accountType. Получите токен из письма и укажите registrationToken. Не запускайте всю ручную коллекцию подряд.
}

