meta {
  name: Изменить свой пароль
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/v1/auth/password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-TOKEN: {{csrfToken}}
}

script:pre-request {
  if (!bru.getVar('csrfToken')) throw new Error('Сначала выполните GET auth/csrf в этой коллекции.');
  
}

body:json {
  {
    "currentPassword": "{{password}}",
    "newPassword": "{{newPassword}}"
  }
}

tests {
  test("HTTP 204", function () {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  Меняет пароль и завершает сессии. Затем обновите password и снова войдите.
}

