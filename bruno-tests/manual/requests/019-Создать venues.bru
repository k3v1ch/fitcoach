meta {
  name: Создать venues
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/api/v1/organizations/{{organizationId}}/dictionaries/venues
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-TOKEN: {{csrfToken}}
}

script:pre-request {
  if (!bru.getVar('csrfToken')) throw new Error('Сначала выполните GET auth/csrf в этой коллекции.');
  
}

body:json {
  {
    "name": "venues {{runId}}",
    "description": "Bruno",
    "address": "Тестовый зал",
    "sortOrder": 0,
    "status": "ACTIVE"
  }
}

script:post-response {
  if (res.getStatus() >= 200 && res.getStatus() < 300) {
    bru.setVar('venueId', res.getBody().id);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Ожидаемый результат проверяется во вкладке Tests. Для изменения данных нужна сессия и актуальный CSRF.
}

