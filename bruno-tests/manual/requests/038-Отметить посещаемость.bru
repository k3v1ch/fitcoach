meta {
  name: Отметить посещаемость
  type: http
  seq: 38
}

put {
  url: {{baseUrl}}/api/v1/organizations/{{organizationId}}/trainings/{{trainingId}}/attendance
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-TOKEN: {{csrfToken}}
}

script:pre-request {
  if (!bru.getVar('csrfToken')) throw new Error('Сначала выполните GET auth/csrf в этой коллекции.');
  
}

body:json {
  [
    {
      "athleteId": "{{athleteId}}",
      "status": "PRESENT"
    }
  ]
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Ожидаемый результат проверяется во вкладке Tests. Для изменения данных нужна сессия и актуальный CSRF.
}

