meta {
  name: Добавить родителя в организацию
  type: http
  seq: 82
}

post {
  url: {{baseUrl}}/api/v1/organizations/{{organizationId}}/members/parents
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-CSRF-TOKEN: {{csrfToken}}
}

script:pre-request {
  if (!bru.getVar('csrfToken')) throw new Error('Сначала выполните GET auth/csrf в этой коллекции.');
  
}

body:json {
  {
    "email": "{{parentEmail}}"
  }
}

script:post-response {
  if (res.getStatus() >= 200 && res.getStatus() < 300) {
    bru.setVar('parentUserId', res.getBody().userId);
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Нужен существующий ACTIVE аккаунт родителя. TRAINER с members.write добавляет PARENT-членство.
}

