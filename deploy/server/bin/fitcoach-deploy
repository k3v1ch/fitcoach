#!/usr/bin/env bash
# Выкладка ФитКоуч на этот сервер.
#   fitcoach-deploy <sha40>     — выложить коммит (образы собираются, если их ещё нет)
#   fitcoach-deploy --rollback  — вернуть предыдущий успешный релиз
#   fitcoach-deploy --status    — текущий релиз и контейнеры
#   fitcoach-deploy --cleanup   — удалить старые релизы и неиспользуемые образы
#   fitcoach-deploy --tags <sha40> — теги образов коммита (backend, edge)
# Образы помечаются по содержимому: backend — хеш дерева backend/, edge — хеш frontend/ + deploy/edge/,
# поэтому неизменённый сервис не пересобирается и не перезапускается. Сначала обновляется backend
# (сайт в это время отдаёт прежний edge), затем edge. Если проверка здоровья не прошла —
# автоматически возвращается прежний релиз.
set -Eeuo pipefail

GIT_DIR=/home/git/Iinformation-system/.git
BASE=/opt/fitcoach
RELEASES=$BASE/releases
ENV_FILE=$BASE/shared/.env
HISTORY=/var/lib/fitcoach/deploy-history   # строки: <UTC> <sha40>
PROJECT=fitcoach
KEEP_RELEASES=5
HEALTH_TIMEOUT=300

log() { printf '[CI] %s\n' "$*"; }
die() { log "ОШИБКА: $*"; exit 1; }
short() { printf '%s' "${1:0:12}"; }
git_() { git -c safe.directory='*' --git-dir="$GIT_DIR" "$@"; }
domain() { sed -n 's/^DOMAIN=//p' "$ENV_FILE" | tail -n 1; }

current_sha() {
  local target
  target=$(readlink "$BASE/current" 2>/dev/null) || return 0
  basename "$target"
}

tree() {  # tree <sha40> <каталог> — хеш дерева каталога в коммите или none
  local id
  # "<коммит>:<путь>" — всё после двоеточия git считает путём, суффиксы вроде ^{tree} сюда нельзя
  id=$(git_ rev-parse -q --verify "$1:$2" 2>/dev/null) || { echo none; return 0; }
  if [[ $(git_ cat-file -t "$id" 2>/dev/null) == tree ]]; then echo "$id"; else echo none; fi
}

image_tags() {  # image_tags <sha40> → "<тег backend> <тег edge>"
  local backend frontend edge
  backend=$(tree "$1" backend)
  frontend=$(tree "$1" frontend)
  edge=$(tree "$1" deploy/edge)
  printf '%s %s\n' "${backend:0:12}" "$(printf '%s %s' "$frontend" "$edge" | sha256sum | cut -c1-12)"
}

compose() {  # compose <sha40> <аргументы docker compose...>
  local sha=$1 bt et
  shift
  read -r bt et < <(image_tags "$sha")
  # IMAGE_TAG нужен compose-файлам старых релизов: там один тег (коммит) на оба образа
  IMAGE_TAG=$(short "$sha") BACKEND_TAG=$bt EDGE_TAG=$et docker compose -p "$PROJECT" --env-file "$ENV_FILE" \
    -f "$RELEASES/$sha/deploy/docker-compose.yml" "$@"
}

export_release() {
  local sha=$1 dir=$RELEASES/$1
  [[ -d $dir ]] && return 0
  rm -rf "$dir.tmp"
  install -d -m 0755 "$dir.tmp"
  git_ archive "$sha" | tar -x -C "$dir.tmp"
  mv "$dir.tmp" "$dir"
}

build_images() {
  local sha=$1 dir=$RELEASES/$1 bt et st
  read -r bt et < <(image_tags "$sha")
  st=$(short "$sha")
  if ! docker image inspect "fitcoach.local/backend:$bt" >/dev/null 2>&1; then
    log "сборка образа backend:$bt"
    docker build --progress=plain -t "fitcoach.local/backend:$bt" "$dir/backend"
  fi
  if ! docker image inspect "fitcoach.local/edge:$et" >/dev/null 2>&1; then
    log "сборка образа edge:$et"
    docker build --progress=plain -f "$dir/deploy/edge/Dockerfile" -t "fitcoach.local/edge:$et" "$dir"
  fi
  # compose-файлы старых релизов ссылаются на образы по тегу коммита
  docker tag "fitcoach.local/backend:$bt" "fitcoach.local/backend:$st"
  docker tag "fitcoach.local/edge:$et" "fitcoach.local/edge:$st"
}

health() { docker inspect -f '{{.State.Health.Status}}' "$PROJECT-$1-1" 2>/dev/null || echo missing; }

wait_service() {  # wait_service <сервис>: ждём healthy; unhealthy, падения при старте или таймаут — ошибка
  local deadline=$((SECONDS + HEALTH_TIMEOUT)) status restarts
  while (( SECONDS < deadline )); do
    status=$(health "$1")
    [[ $status == healthy ]] && return 0
    [[ $status == unhealthy ]] && return 1
    restarts=$(docker inspect -f '{{.RestartCount}}' "$PROJECT-$1-1" 2>/dev/null || echo 0)
    if (( restarts > 0 )); then
      log "$1 падает при старте"
      return 1
    fi
    sleep 3
  done
  return 1
}

via_nginx() {
  local d
  d=$(domain)
  curl -fsSk -o /dev/null --max-time 10 --resolve "$d:443:127.0.0.1" "https://$d/v3/api-docs"
}

record() {
  ln -sfn "$RELEASES/$1" "$BASE/current"
  printf '%s %s\n' "$(date -u +%FT%TZ)" "$1" >> "$HISTORY"
}

keep_list() { tac "$HISTORY" 2>/dev/null | awk '!seen[$2]++ {print $2}' | head -n "$KEEP_RELEASES" || true; }

cleanup() {
  local keep keep_tags=" " sha bt et d img
  keep=$(keep_list)
  for sha in $keep; do
    read -r bt et < <(image_tags "$sha")
    keep_tags+="backend:$bt edge:$et backend:$(short "$sha") edge:$(short "$sha") "
  done
  for d in "$RELEASES"/*; do
    [[ -d $d ]] || continue
    grep -qx "${d##*/}" <<<"$keep" || rm -rf "$d"
  done
  docker images --format '{{.Repository}}:{{.Tag}}' | { grep -E '^fitcoach\.local/(backend|edge):' || true; } |
    while read -r img; do
      [[ $keep_tags == *" ${img#fitcoach.local/} "* ]] || docker rmi "$img" >/dev/null 2>&1 || true
    done
  docker image prune -f >/dev/null
  docker builder prune -f --filter until=72h >/dev/null 2>&1 || true
}

up_and_check() {  # up_and_check <sha40>: сначала db и backend (сайт отдаёт прежний edge), затем edge
  compose "$1" up -d --remove-orphans db files-perms backend &&
    wait_service backend &&
    compose "$1" up -d --remove-orphans &&
    wait_service edge &&
    via_nginx
}

deploy() {
  local sha=$1 prev
  [[ $sha =~ ^[0-9a-f]{40}$ ]] || die "нужен полный sha коммита (40 символов)"
  git_ cat-file -e "$sha^{commit}" 2>/dev/null || die "коммита $sha нет в репозитории"
  [[ -f $ENV_FILE ]] || die "нет $ENV_FILE"
  prev=$(current_sha)
  export_release "$sha"
  [[ -f $RELEASES/$sha/deploy/docker-compose.yml ]] || die "в коммите нет deploy/docker-compose.yml"
  build_images "$sha"
  /usr/local/sbin/fitcoach-cert link-only
  if [[ -n $prev && $prev != "$sha" ]]; then
    /usr/local/sbin/fitcoach-backup "pre-deploy-$(short "$sha")" >/dev/null || log "предупреждение: бэкап перед выкладкой не удался"
  fi
  log "выкладка $(short "$sha")"
  if up_and_check "$sha"; then
    record "$sha"
    log "готово: на проде $(short "$sha")"
    cleanup
    return 0
  fi
  log "проверка здоровья не прошла"
  compose "$sha" ps || true
  compose "$sha" logs --tail 60 backend || true
  if [[ -n $prev && $prev != "$sha" ]]; then
    log "откат на $(short "$prev")"
    if up_and_check "$prev"; then
      log "откат выполнен, на проде $(short "$prev")"
    else
      log "ОТКАТ НЕ УДАЛСЯ — нужен ручной разбор"
    fi
  fi
  return 1
}

rollback() {
  local cur prev
  cur=$(current_sha)
  prev=$(awk -v cur="$cur" '$2 != cur {p = $2} END {print p}' "$HISTORY" 2>/dev/null || true)
  [[ -n $prev ]] || die "нет предыдущего релиза"
  export_release "$prev"
  build_images "$prev"
  log "откат на $(short "$prev")"
  up_and_check "$prev" || die "откат не прошёл проверку здоровья"
  record "$prev"
  log "готово: на проде $(short "$prev")"
}

status() {
  echo "текущий релиз: $(current_sha)"
  echo "последние выкладки:"
  tail -n 5 "$HISTORY" 2>/dev/null || true
  docker ps -a --filter "label=com.docker.compose.project=$PROJECT" --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}'
}

install -d -m 0700 "$(dirname "$HISTORY")"
case "${1:-}" in
  --status) status ;;
  --tags)
    [[ ${2:-} =~ ^[0-9a-f]{40}$ ]] || die "нужен полный sha коммита"
    image_tags "$2" ;;
  --cleanup)
    exec 9>/run/fitcoach-deploy.lock
    flock -w 1800 9 || die "другая выкладка не закончилась"
    cleanup ;;
  --rollback)
    exec 9>/run/fitcoach-deploy.lock
    flock -w 1800 9 || die "другая выкладка не закончилась"
    rollback ;;
  ""|-h|--help) sed -n '2,12p' "$0" ;;
  *)
    exec 9>/run/fitcoach-deploy.lock
    flock -w 1800 9 || die "другая выкладка не закончилась"
    deploy "$1" ;;
esac
