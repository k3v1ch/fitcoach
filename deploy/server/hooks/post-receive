#!/bin/sh
# ФитКоуч CI: ставит задание на каждую обновлённую ветку и показывает пушащему ход сборки.
# Сборку выполняет root-воркер fitcoach-ci (systemd); Ctrl+C здесь её не останавливает.
SPOOL=/var/spool/fitcoach-ci
LOGDIR=/var/log/fitcoach-ci
ZERO=0000000000000000000000000000000000000000

ids=""
n=0
now=$(date +%s)
rnd=$(od -An -N3 -tx1 /dev/urandom | tr -d ' \n')
while read -r _ new ref; do
  [ "$new" = "$ZERO" ] && continue
  case "$ref" in refs/heads/*) ;; *) continue ;; esac
  # <время>-<номер ref в пуше><случайное>: воркер берёт задания по имени, то есть в порядке пуша
  id="$now-$(printf '%02x' "$n")$rnd"
  n=$((n + 1))
  if printf '%s %s\n' "$ref" "$new" > "$SPOOL/.$id.tmp" && mv "$SPOOL/.$id.tmp" "$SPOOL/$id.job"; then
    echo "[CI] задание $id: ${ref#refs/heads/} @ $(printf '%.12s' "$new")"
    ids="$ids $id"
  else
    echo "[CI] не удалось поставить задание для $ref"
  fi
done
[ -n "$ids" ] || exit 0
echo "[CI] Ctrl+C не остановит сборку. Статус потом: ssh git@<сервер> ci-status"

stream() {
  log="$LOGDIR/$1.log"
  st="$LOGDIR/$1.status"
  seen=0
  waited=0
  idle=0
  queued=""
  while [ "$waited" -lt 2700 ]; do
    if [ -r "$log" ]; then
      total=$(wc -l < "$log")
      if [ "$total" -gt "$seen" ]; then
        sed -n "$((seen + 1)),${total}p" "$log" | grep -a '^\[CI\]'
        seen=$total
      fi
    elif [ -e "$SPOOL/$1.job" ] &&
         [ "$(systemctl show -p ActiveState --value fitcoach-ci.service 2>/dev/null)" = activating ]; then
      # задание ждёт в очереди, пока воркер собирает другое
      [ -n "$queued" ] || echo "[CI] задание в очереди: воркер занят другой сборкой"
      queued=1
    elif [ "$idle" -ge 60 ]; then
      echo "[CI] воркер не взял задание за минуту — сообщите DevOps (fitcoach-ci.path)"
      return
    else
      idle=$((idle + 2))
    fi
    if [ -r "$st" ]; then
      total=$(wc -l < "$log")
      [ "$total" -gt "$seen" ] && sed -n "$((seen + 1)),${total}p" "$log" | grep -a '^\[CI\]'
      read -r result _ < "$st"
      if [ "$result" != OK ]; then
        echo "[CI] последние строки лога:"
        tail -n 40 "$log"
      fi
      echo "[CI] итог: $(cat "$st")"
      return
    fi
    sleep 2
    waited=$((waited + 2))
  done
  echo "[CI] сборка ещё идёт: ssh git@<сервер> ci-status $1"
}

for id in $ids; do stream "$id"; done
exit 0
