[Unit]
Description=FitCoach CI: тесты, сборка, выкладка
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=/usr/local/sbin/fitcoach-ci
Nice=10
# Предел на весь запуск убивал бы здоровое задание в длинной очереди;
# у каждого шага задания свой timeout (тесты и сборки 30 мин, выкладка 20 мин)
TimeoutStartSec=infinity
